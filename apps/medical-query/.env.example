# 复制为 .env.local 后填入个人密钥；不要提交 .env.local。
PI_MODEL_API_KEY=
# 使用 DeepSeek 官方接口与通用模型名；如使用兼容网关，可改为自己的端点和模型名。
PI_MODEL_BASE_URL=https://api.deepseek.com
PI_DECISION_MODEL=deepseek-chat
PI_ANSWER_MODEL=deepseek-chat
PI_MAX_ACTIVE_RUNS=5
PI_LLM_MAX_CONCURRENCY=5
PI_EVAL_MAX_ACTIVE_RUNS=5
PI_QUEUE_MAX_PENDING=100
# 在线保留等待位置；SQL、修复和调用预算均由协调器统一约束。
PI_ONLINE_QUEUE_RESERVE=20
PI_SQL_CONCURRENCY=2
PI_TURN_REPAIR_LIMIT=1
PI_TURN_MODEL_CALL_LIMIT=8
PI_RESULT_MAX_ROWS=5000
PI_QUEUE_WAIT_TIMEOUT_S=300
PI_LLM_REQUEST_TIMEOUT_S=120
PI_RUN_TIMEOUT_S=600
PI_PORT=8787
# 检索预算随会话/实验冻结；progressive先读表索引，再按需加载字段及关联。
PI_RETRIEVAL_STRATEGY=progressive
PI_RETRIEVAL_MAX_CONTEXT_CHARS=256000
# 渐进披露首轮最多5张直接业务表；lexical、full_catalog对照默认12。
PI_RETRIEVAL_TOP_K=5
# 按账户实际限额设置；留空表示未启用速率门，不代表无限供应商额度。
PI_RESOURCE_SCOPE_ID=primary-account
PI_ACCOUNT_RPM=
PI_ACCOUNT_TPM=
