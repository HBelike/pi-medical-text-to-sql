{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "root": true,
  "formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "style": { "noNonNullAssertion": "off" } }
  },
  "files": { "includes": ["src/**/*.ts", "test/**/*.ts", "web/*.js"] }
}
